---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | Online Model Cost"
  description="How to reach Model Cost about the token calculator, API cost calculator, or catalog rates."
>
  <main id="main" class="shell">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch.</h1>
    <div class="prose">
      <p>
        For questions about the calculators, rates, or this site, email
        <a href="mailto:hello@onlinemodelcost.com">hello@onlinemodelcost.com</a>.
      </p>
      <p>
        Include which page you were on (token calculator, API cost calculator,
        or rates) and what you expected to see. Do not send prompts that contain
        secrets; we do not need the paste to debug a count.
      </p>
      <p>
        Catalog prices are listed on <a href="/rates">rates</a>. Privacy and
        terms are on their own pages.
      </p>
    </div>
  </main>
</Layout>
